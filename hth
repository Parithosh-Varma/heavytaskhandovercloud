#!/usr/bin/env python3
"""hth - hand long-running tasks off to Google Cloud Shell.

Usage:
  hth init
  hth run <cmd|file> [--files ...] [--setup FILE] [--keepalive] [--dry-run]
  hth status [id]
  hth logs <id> [-f]
  hth pull <id>
  hth kill <id>
  hth clean [id]

All Cloud Shell interaction goes through `gcloud cloud-shell ssh` and
`gcloud cloud-shell scp`. No project ids or credentials are hardcoded.
"""
import argparse
import datetime
import json
import os
import random
import secrets
import shlex
import shutil
import subprocess
import sys
import tempfile
import time
import traceback
from pathlib import Path

try:
    _HERE = os.path.dirname(os.path.abspath(__file__))
    if _HERE not in sys.path:
        sys.path.insert(0, _HERE)
    from lib import ui
except Exception:
    # Running without lib/ (e.g. copied binary): fall back to plain output.
    # This path is never used in the repo checkout.
    sys.stderr.write("error: lib/ui.py not found next to hth\n")
    sys.exit(1)

VERSION = "0.1.0"
REMOTE_BASE = "~/hth/jobs"
LOCAL_DIR = Path.home() / ".hth"
LOCAL_JOBS_FILE = LOCAL_DIR / "jobs.json"
KEEPALIVE_INTERVAL_SEC = 240


# ---------- output: everything routes through lib/ui.py ----------

def eprint(*a, **k):
    sep = k.get("sep", " ")
    end = k.get("end", "\n")
    ui.err(sep.join(str(x) for x in a) + ("" if end == "\n" else end))


def ok(msg):
    ui.info(msg)


def warn(msg):
    ui.warn(msg)


def fail(title, why=None, fix=None, code=1):
    # Backwards-compatible: fail("some text") still works; new call sites
    # pass why/fix for the structured error format.
    if why is None and fix is None and "\n" in str(title):
        parts = str(title).splitlines()
        title, rest = parts[0], "\n".join(parts[1:])
        # Heuristic: lines starting with two spaces or containing a command are the fix.
        why, fix = rest, None
    ui.error(title, why=why, fix=fix)
    sys.exit(code)


def sh_join(cmd):
    try:
        return shlex.join(cmd)
    except Exception:
        return " ".join(cmd)


# ---------- effective flags ----------

def effective_dry_run(args):
    return bool(getattr(args, "global_dry_run", False) or getattr(args, "dry_run", False))


def effective_no_color(args):
    return bool(getattr(args, "global_no_color", False) or getattr(args, "no_color", False))


def effective_debug(args):
    return bool(getattr(args, "global_debug", False) or getattr(args, "debug", False))


def effective_project(args):
    p = getattr(args, "project", None) or getattr(args, "global_project", None)
    if p:
        return p
    for k in ("HTH_PROJECT", "GOOGLE_CLOUD_PROJECT", "GCLOUD_PROJECT", "CLOUDSDK_CORE_PROJECT"):
        v = os.environ.get(k)
        if v:
            return v
    return None


# ---------- gcloud command builders (pure, easy to dry-run) ----------

def build_ssh_cmd(remote_cmd, authorize=False, project=None):
    cmd = ["gcloud", "cloud-shell", "ssh"]
    if project:
        cmd.append("--project=" + project)
    if authorize:
        cmd.append("--authorize-session")
    cmd.append("--command=" + remote_cmd)
    return cmd


def build_scp_cmd(srcs, dest, recurse=False, project=None):
    """srcs: list of 'localhost:...' / 'cloudshell:...' strings. dest: one such string."""
    cmd = ["gcloud", "cloud-shell", "scp"]
    if project:
        cmd.append("--project=" + project)
    if recurse:
        cmd.append("--recurse")
    cmd.extend(srcs)
    cmd.append(dest)
    return cmd


def friendly_gcloud_error(stderr, cmd):
    s = (stderr or "").lower()
    if "quota" in s or "exhausted" in s or "resource_exhausted" in s or "429" in s:
        return (
            ("Cloud Shell quota exhausted or unavailable.",
             "Free Cloud Shell has weekly/CPU limits; the VM may also be starting.",
             "Wait a few minutes and retry: hth init")
        )
    if "unauthenticated" in s or "reauth" in s or "not logged in" in s or "no active account" in s:
        return (
            ("gcloud is not logged in.",
             "No active account found for gcloud.",
             "gcloud auth login")
        )
    if "permission denied" in s or "permissiondenied" in s or "403" in s:
        return (
            ("Permission denied talking to Cloud Shell.",
             "The gcloud account lacks Cloud Shell access or the project forbids it.",
             "gcloud auth login  # then: hth init")
        )
    if "authorize" in s and "session" in s:
        return (
            ("Cloud Shell session needs authorization.",
             "The session token was rejected.",
             "hth init")
        )
    return None


def run_gcloud(cmd, dry_run=False, capture=True, check_text="gcloud"):
    """Run a gcloud command. In dry-run, print and return a fake success."""
    if dry_run:
        ui.dry_run_cmd(cmd)
        class Fake:
            returncode = 0
            stdout = ""
            stderr = ""
        return Fake()
    try:
        r = subprocess.run(cmd, capture_output=capture, text=True)
    except FileNotFoundError:
        fail(
            "gcloud CLI not found",
            why="hth shells out to gcloud for every Cloud Shell operation.",
            fix="Install it: https://cloud.google.com/sdk/docs/install  # then: gcloud auth login && hth init"
        )
    if r.returncode != 0:
        structured = friendly_gcloud_error((r.stderr or "") + "\n" + (r.stdout or ""), cmd)
        if structured:
            title, why, fix = structured
            tail = (r.stderr or r.stdout or "")[-800:].strip()
            if tail:
                why = why + "\nDetails: " + " ".join(tail.split())[:300]
            ui.error(title, why=why, fix=fix)
            if ui.is_debug():
                ui.err("--- raw gcloud output ---")
                ui.err((r.stderr or r.stdout or "")[-3000:].strip())
                traceback.print_exc()
            sys.exit(1)
        ui.error(
            "gcloud failed (exit %d)" % r.returncode,
            why=" ".join((r.stderr or "")[-800:].split())[:400] or sh_join(cmd),
            fix="hth init --dry-run  # inspect the exact gcloud invocation"
        )
        if ui.is_debug():
            traceback.print_exc()
        sys.exit(1)
    return r


def check_gcloud_exists():
    if shutil.which("gcloud") is None:
        fail(
            "gcloud CLI not found",
            why="hth shells out to gcloud for every Cloud Shell operation.",
            fix="Install it: https://cloud.google.com/sdk/docs/install  # then: gcloud auth login && hth init"
        )


def check_gcloud_auth(dry_run=False, project=None):
    """Verify `gcloud auth list` has an active account. Returns account or ''."""
    cmd = ["gcloud", "auth", "list", "--filter=status:ACTIVE", "--format=value(account)"]
    if dry_run:
        ui.dry_run_cmd(cmd)
        return "dry-run@example.com"
    try:
        r = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        fail(
            "gcloud CLI not found",
            why="Could not execute gcloud.",
            fix="Install it: https://cloud.google.com/sdk/docs/install"
        )
    if r.returncode != 0 or not (r.stdout or "").strip():
        fail(
            "gcloud is not logged in",
            why="No active account in `gcloud auth list`.",
            fix="gcloud auth login  # then: hth init"
        )
    return (r.stdout or "").strip().splitlines()[0].strip()


# ---------- local state ----------

def ensure_local_state():
    try:
        LOCAL_DIR.mkdir(parents=True, exist_ok=True)
        if not LOCAL_JOBS_FILE.exists():
            LOCAL_JOBS_FILE.write_text("{}\n", encoding="utf-8")
    except Exception as ex:
        fail("cannot create %s" % LOCAL_DIR, why=str(ex),
             fix="mkdir -p %s  # then retry" % LOCAL_DIR)


def load_jobs():
    ensure_local_state()
    try:
        data = json.loads(LOCAL_JOBS_FILE.read_text(encoding="utf-8") or "{}")
        if not isinstance(data, dict):
            return {}
        return data
    except Exception:
        warn("local state %s is corrupt; starting fresh" % LOCAL_JOBS_FILE)
        return {}


def save_jobs(jobs):
    ensure_local_state()
    tmp = LOCAL_JOBS_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(jobs, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    tmp.replace(LOCAL_JOBS_FILE)


def make_job_id():
    ts = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%d-%H%M%S")
    rnd = secrets.token_hex(3)  # 6 hex chars
    return "%s-%s" % (ts, rnd)


def utc_now_iso():
    return datetime.datetime.now(datetime.timezone.utc).isoformat()


def parse_iso(s):
    try:
        # Python 3.9: fromisoformat does not handle 'Z'; we always write +00:00
        return datetime.datetime.fromisoformat(s)
    except Exception:
        return None


def format_elapsed(start_iso):
    dt = parse_iso(start_iso) if start_iso else None
    if dt is None:
        return "?"
    now = datetime.datetime.now(datetime.timezone.utc)
    if dt.tzinfo is None:
        dt = dt.replace(tzinfo=datetime.timezone.utc)
    delta = now - dt
    secs = int(max(0, delta.total_seconds()))
    h, rem = divmod(secs, 3600)
    m, s = divmod(rem, 60)
    if h:
        return "%dh %dm %ds" % (h, m, s)
    if m:
        return "%dm %ds" % (m, s)
    return "%ds" % s


def valid_job_id(jid):
    if not jid:
        return False
    # timestamp-rand, safe for tmux session names and shell paths
    allowed = set("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-_")
    return all(c in allowed for c in jid) and len(jid) <= 64


# ---------- remote helpers ----------

def remote_job_dir(jid):
    return "%s/%s" % (REMOTE_BASE, jid)


def ssh_run(remote_cmd, dry_run=False, project=None, authorize=False):
    cmd = build_ssh_cmd(remote_cmd, authorize=authorize, project=project)
    return run_gcloud(cmd, dry_run=dry_run)


def ensure_remote_base(dry_run=False, project=None):
    ssh_run("mkdir -p %s && echo ok" % REMOTE_BASE, dry_run=dry_run, project=project)


def remote_probe_single(jid, dry_run=False, project=None):
    """Return (status, exit_code_or_None, raw). status in running/done/failed/lost/missing."""
    # Single ssh that prints machine-readable lines.
    remote_cmd = (
        'ID=%s; DIR=~/hth/jobs/$ID; '
        'if [ ! -d "$DIR" ]; then echo "HTH_STATUS=missing"; exit 0; fi; '
        'if tmux has-session -t "$ID" 2>/dev/null; then echo "HTH_STATUS=running"; exit 0; fi; '
        'if [ -f "$DIR/exit_code" ]; then RC=$(cat "$DIR/exit_code" 2>/dev/null | tr -d " \\t\\r\\n"); '
        'echo "HTH_STATUS=exit:$RC"; exit 0; fi; '
        'echo "HTH_STATUS=lost"' % shlex.quote(jid)
    )
    r = ssh_run(remote_cmd, dry_run=dry_run, project=project)
    if dry_run:
        return ("dry-run", None, "")
    out = (r.stdout or "")
    status = "lost"
    rc = None
    for line in out.splitlines():
        line = line.strip()
        if line.startswith("HTH_STATUS="):
            v = line.split("=", 1)[1].strip()
            if v == "running":
                status = "running"
            elif v == "missing":
                status = "missing"
            elif v == "lost":
                status = "lost"
            elif v.startswith("exit:"):
                code = v.split(":", 1)[1].strip()
                try:
                    rc = int(code)
                except Exception:
                    rc = None
                if rc == 0:
                    status = "done"
                else:
                    status = "failed"
    return (status, rc, out)


def remote_list_all(dry_run=False, project=None):
    """Return dict id -> (status, exit_or_None) via a single ssh."""
    remote_cmd = (
        'mkdir -p ~/hth/jobs; '
        'for d in ~/hth/jobs/*; do '
        '[ -d "$d" ] || continue; '
        'id=$(basename "$d"); '
        'if tmux has-session -t "$id" 2>/dev/null; then st="running"; '
        'elif [ -f "$d/exit_code" ]; then rc=$(cat "$d/exit_code" 2>/dev/null | tr -d " \\t\\r\\n"); '
        'if [ "$rc" = "0" ]; then st="done"; else st="failed:$rc"; fi; '
        'else st="lost"; fi; '
        'echo "$id $st"; done'
    )
    r = ssh_run(remote_cmd, dry_run=dry_run, project=project)
    if dry_run:
        return {}
    result = {}
    for line in (r.stdout or "").splitlines():
        parts = line.strip().split()
        if not parts:
            continue
        jid = parts[0]
        st = parts[1] if len(parts) > 1 else "lost"
        if st == "running":
            result[jid] = ("running", None)
        elif st == "done":
            result[jid] = ("done", 0)
        elif st.startswith("failed"):
            try:
                rc = int(st.split(":")[1])
            except Exception:
                rc = 1
            result[jid] = ("failed", rc)
        elif st == "lost":
            result[jid] = ("lost", None)
        else:
            result[jid] = (st, None)
    return result


# ---------- commands ----------

def cmd_init(args):
    dry_run = effective_dry_run(args)
    project = effective_project(args)
    check_gcloud_exists()
    acct = check_gcloud_auth(dry_run=dry_run, project=project)
    if dry_run:
        ui.dry_run_cmd(build_ssh_cmd('echo ready', authorize=True, project=project))
        ui.dry_run_cmd(build_ssh_cmd("mkdir -p %s && echo ok" % REMOTE_BASE, project=project))
        ui.hint("dry-run: would ensure %s exists" % LOCAL_JOBS_FILE)
        ui.next_step("hth init  # for real")
        return 0
    ui.banner()
    ui.info("account  %s" % acct)
    try:
        with ui.step("Starting Cloud Shell"):
            ssh_run("echo ready", dry_run=False, project=project, authorize=True)
        with ui.step("Creating ~/hth/jobs"):
            ensure_remote_base(dry_run=False, project=project)
        ensure_local_state()
    except SystemExit:
        raise
    except Exception as ex:
        if ui.is_debug():
            traceback.print_exc()
        fail("init failed", why=str(ex), fix="hth init --dry-run  # inspect commands, then retry")
    ui.info("")
    ui.info("ready  %s on Cloud Shell" % REMOTE_BASE)
    ui.info("local  %s" % LOCAL_JOBS_FILE)
    ui.next_step('hth run "python3 examples/scrape_example.py"')
    return 0


def build_run_wrapper(job_id, main_line):
    return """#!/bin/bash
# hth job %s - generated wrapper, do not edit by hand
set -u
cd "$HOME/hth/jobs/%s" || { echo "[hth] cannot cd to job dir"; exit 127; }
mkdir -p output
echo "[hth] starting $(date -u +%%FT%%TZ 2>/dev/null || date -u) id=%s"
if [ -f setup.sh ]; then
  echo "[hth] running setup.sh..."
  bash setup.sh
  SETUP_RC=$?
  if [ "$SETUP_RC" -ne 0 ]; then
    echo "[hth] setup.sh failed with exit $SETUP_RC"
    echo "$SETUP_RC" > exit_code
    exit "$SETUP_RC"
  fi
fi
echo "[hth] running main command..."
%s
MAIN_RC=$?
echo "$MAIN_RC" > exit_code
echo "[hth] finished with exit $MAIN_RC"
exit "$MAIN_RC"
""" % (job_id, job_id, job_id, main_line)


def cmd_run(args):
    dry_run = effective_dry_run(args)
    project = effective_project(args)
    check_gcloud_exists()
    if not dry_run:
        check_gcloud_auth(dry_run=False, project=project)

    target = args.target
    extra = args.extra or []
    files = args.files or []
    setup_file = getattr(args, "setup", None)

    # Validate --files / --setup exist locally (unless dry-run with missing? still warn)
    for f in files:
        if not os.path.exists(f):
            fail("file not found: %s" % f,
                 why="It was passed via --files but does not exist locally.",
                 fix="ls %s  # check the path, then retry hth run" % f)
    if setup_file and not os.path.exists(setup_file):
        fail("setup file not found: %s" % setup_file,
             why="It was passed via --setup but does not exist locally.",
             fix="ls %s  # check the path, then retry hth run" % setup_file)

    job_id = make_job_id()
    if not valid_job_id(job_id):
        fail("internal: bad job id", why="Generated id failed validation. This is a bug.",
             fix="hth --debug run ...  # re-run with a traceback")
    rdir = remote_job_dir(job_id)

    # Decide main command line (runs inside ~/hth/jobs/<id> as cwd)
    is_file = os.path.isfile(target) if target else False
    if not is_file and target:
        # Looks like a script path but doesn't exist locally? Fail early
        # instead of sending a doomed command to Cloud Shell.
        looks_like_path = (
            target.endswith((".py", ".sh", ".bash")) or
            ("/" in target and " " not in target)
        )
        if looks_like_path:
            fail("file not found: %s" % target,
                 why="It looks like a script path but does not exist locally.",
                 fix='hth run "%s"  # if it was meant as a shell command, quote it' % target)
    main_basename = None
    if is_file:
        main_basename = os.path.basename(target)
        quoted_extra = sh_join(extra) if extra else ""
        if target.endswith(".py"):
            main_line = ("python3 ./%s %s" % (shlex.quote(main_basename), quoted_extra)).strip()
        else:
            # .sh or anything else: run with bash
            main_line = ("bash ./%s %s" % (shlex.quote(main_basename), quoted_extra)).strip()
        display_cmd = ("%s %s" % (target, sh_join(extra) if extra else "")).strip()
    else:
        full = " ".join([target] + extra).strip() if target else ""
        if not full:
            fail("run needs a command or script file",
                 why="No command or file was given.",
                 fix='hth run "python3 job.py"  # or: hth run ./script.py')
        main_line = full
        display_cmd = full

    wrapper = build_run_wrapper(job_id, main_line)

    # Prepare upload list: (local_path, remote_basename)
    uploads = []  # list of (local, remote_name)
    tmp_wrapper = None
    if is_file:
        uploads.append((target, main_basename))
    else:
        # command-string: still upload a wrapper only; no user script
        pass
    for f in files:
        # If a dir is passed, we upload the whole dir via --recurse; remote name = basename
        uploads.append((f, os.path.basename(os.path.abspath(f.rstrip("/")))))
    if setup_file:
        # upload as setup.sh regardless of local name
        uploads.append((setup_file, "setup.sh"))

    # Write wrapper to temp file for scp
    if not dry_run:
        fd, tmppath = tempfile.mkstemp(prefix="hth-run-%s-" % job_id, suffix=".sh")
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(wrapper)
        tmp_wrapper = tmppath
        uploads.append((tmppath, "run.sh"))
    else:
        uploads.append(("<generated run.sh>", "run.sh"))

    # 1) mkdir remote
    mkdir_cmd = "mkdir -p %s/output && rm -f %s/out.log %s/exit_code && echo ok" % (rdir, rdir, rdir)
    if dry_run:
        ui.dry_run_cmd(build_ssh_cmd(mkdir_cmd, project=project))
    else:
        # auto-heal: ensure base exists (handles VM reset)
        try:
            with ui.step("Creating remote job dir"):
                ssh_run(mkdir_cmd, dry_run=False, project=project)
        except SystemExit:
            raise
        except Exception as ex:
            if ui.is_debug():
                traceback.print_exc()
            fail("cannot create remote job dir", why=str(ex),
                 fix="hth init  # re-authorize Cloud Shell, then retry")

    # 2) scp uploads (batch where possible; dirs need --recurse)
    # Group: single scp call with --recurse if any dir, else without.
    needs_recurse = any(os.path.isdir(p) for (p, _) in uploads if p and not p.startswith("<generated"))
    if dry_run:
        # Show one scp per file for clarity, plus wrapper
        for (lp, rn) in uploads:
            src = "localhost:%s" % lp
            dst = "cloudshell:%s/%s" % (rdir, rn)
            # for dirs, scp the dir itself into job dir
            ui.dry_run_cmd(build_scp_cmd([src], dst, recurse=os.path.isdir(lp) if not lp.startswith("<generated") else False, project=project))
    else:
        with ui.step("Copying %d file(s)" % len(uploads)):
            for (lp, rn) in uploads:
                if lp == tmp_wrapper:
                    src = "localhost:%s" % lp
                else:
                    # allow relative paths; gcloud scp accepts local paths
                    src = "localhost:%s" % lp
                dst = "cloudshell:%s/%s" % (rdir, rn)
                # If source is a dir, destination should be the job dir (scp -r src jobdir/)
                # to avoid double-nesting confusion, we scp dir -> jobdir/
                if os.path.isdir(lp):
                    dst_dir = "cloudshell:%s/" % rdir
                    cmd = build_scp_cmd([src], dst_dir, recurse=True, project=project)
                else:
                    cmd = build_scp_cmd([src], dst, recurse=False, project=project)
                run_gcloud(cmd, dry_run=False)
        # chmod +x run.sh + main script if needed
        ssh_run("chmod +x %s/run.sh && chmod +x %s/%s 2>/dev/null || true; ls -la %s" % (
            rdir, rdir, shlex.quote(main_basename) if main_basename else "run.sh", rdir),
            dry_run=False, project=project)

    # 3) launch detached in tmux (never block)
    # job_id is [A-Za-z0-9-_], safe for tmux -s and shell paths.
    launch = (
        "tmux kill-session -t {jid} 2>/dev/null || true; "
        "tmux new-session -d -s {jid} 'bash ~/hth/jobs/{jid}/run.sh >> ~/hth/jobs/{jid}/out.log 2>&1' && echo launched"
    ).format(jid=job_id)
    if dry_run:
        ui.dry_run_cmd(build_ssh_cmd(launch, project=project))
        # cleanup temp? none created in dry-run
        ui.hint("dry-run: would record job %s locally" % job_id)
        ui.info(job_id)
        ui.next_step("hth run \"%s\"  # for real (remove --dry-run)" % display_cmd[:60])
        return 0

    with ui.step("Launching detached job"):
        ssh_run(launch, dry_run=False, project=project)

    # 4) record locally
    jobs = load_jobs()
    jobs[job_id] = {
        "id": job_id,
        "command": display_cmd,
        "start_time": utc_now_iso(),
        "last_known_status": "running",
        "remote_dir": rdir,
    }
    save_jobs(jobs)

    # cleanup temp wrapper
    try:
        if tmp_wrapper and os.path.exists(tmp_wrapper):
            os.unlink(tmp_wrapper)
    except Exception:
        pass

    # 5) keepalive?
    if getattr(args, "keepalive", False):
        start_keepalive(job_id, dry_run=False, project=project)

    ui.blank()
    ui.info("job  %s" % ui.accent(job_id))
    ui.info("cmd  %s" % display_cmd[:100])
    ui.next_step("hth logs %s -f  # follow output" % job_id)
    return 0


def start_keepalive(job_id, dry_run=False, project=None):
    pidfile = LOCAL_DIR / ("keepalive-%s.pid" % job_id)
    if dry_run:
        ui.hint("keepalive: would spawn background ssh ping every %ds for job %s" % (KEEPALIVE_INTERVAL_SEC, job_id))
        ui.dry_run_cmd(build_ssh_cmd("echo keepalive", project=project))
        return 0
    ensure_local_state()
    # Spawn detached `hth _keepalive <id>` loop
    hth_path = os.path.abspath(sys.argv[0])
    cmd = [sys.executable, hth_path, "_keepalive", job_id]
    if project:
        cmd += ["--project", project]
    try:
        p = subprocess.Popen(
            cmd,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        try:
            pidfile.write_text(str(p.pid) + "\n", encoding="utf-8")
        except Exception:
            pass
        ui.hint("keepalive on (pid %d, every %ds). Stops on hth kill/clean." % (p.pid, KEEPALIVE_INTERVAL_SEC))
    except Exception as ex:
        warn(str(ex))
    return 0


def cmd_keepalive_loop(args):
    # hidden: `hth _keepalive <id>` - ping Cloud Shell forever (until killed)
    job_id = args.target if hasattr(args, "target") and args.target else (args.job_id if hasattr(args, "job_id") else None)
    if isinstance(job_id, list):
        job_id = job_id[0] if job_id else None
    project = effective_project(args)
    # No dry-run here; just loop
    while True:
        try:
            jobs = load_jobs()
            st = (jobs.get(job_id or "") or {}).get("last_known_status", "")
            if st in ("done", "failed", "killed", "cleaned"):
                break
        except Exception:
            pass
        try:
            ssh_run("echo keepalive $(date -u +%%FT%%TZ 2>/dev/null || date -u) >/dev/null 2>&1 && echo ok",
                    dry_run=False, project=project)
        except Exception:
            pass
        time.sleep(KEEPALIVE_INTERVAL_SEC)
    return 0


def stop_keepalive(job_id):
    pidfile = LOCAL_DIR / ("keepalive-%s.pid" % job_id)
    try:
        if pidfile.exists():
            pid = int(pidfile.read_text(encoding="utf-8").strip().split()[0])
            try:
                os.kill(pid, 15)
            except Exception:
                pass
            try:
                pidfile.unlink()
            except Exception:
                pass
    except Exception:
        pass


def cmd_status(args):
    dry_run = effective_dry_run(args)
    project = effective_project(args)
    check_gcloud_exists()
    jobs = load_jobs()
    jid = getattr(args, "job_id", None)

    if jid and not valid_job_id(jid):
        fail("bad job id: %s" % jid,
             why="Job ids look like YYYYMMDD-HHMMSS-xxxxxx (letters, digits, -).",
             fix="hth status  # list known jobs, then copy an id")

    if dry_run:
        if jid:
            ui.dry_run_cmd(build_ssh_cmd("probe job %s" % jid, project=project))
        else:
            ui.dry_run_cmd(build_ssh_cmd("list ~/hth/jobs/*", project=project))
        ui.hint("dry-run: would merge remote state with %s" % LOCAL_JOBS_FILE)
        return 0

    if jid:
        info = jobs.get(jid)
        if info is None:
            # Unknown locally - still probe remote (maybe created elsewhere)
            warn("job %s not in %s; probing Cloud Shell anyway" % (jid, LOCAL_JOBS_FILE))
            start_iso = None
            cmd_str = "(unknown)"
        else:
            start_iso = info.get("start_time")
            cmd_str = info.get("command", "")
        try:
            with ui.step("Checking %s" % jid):
                status, rc, _raw = remote_probe_single(jid, dry_run=False, project=project)
        except SystemExit:
            raise
        except Exception as ex:
            if ui.is_debug():
                traceback.print_exc()
            fail("status check failed", why=str(ex), fix="hth status %s --dry-run  # inspect probe" % jid)

        if status == "missing":
            ui.error("job %s not found on Cloud Shell" % jid,
                     why="It was cleaned (hth clean) or the Cloud Shell $HOME was reset.",
                     fix="hth run ...  # re-run the job")
            try:
                ensure_remote_base(dry_run=False, project=project)
            except Exception:
                pass
            if info is not None:
                info["last_known_status"] = "missing"
                jobs[jid] = info
                save_jobs(jobs)
            ui.info("id      %s" % ui.accent(jid))
            ui.info("state   %s" % ui.badge("lost"))
            if start_iso:
                ui.info("started %s (%s ago)" % (start_iso, format_elapsed(start_iso)))
            ui.next_step("hth run ...  # re-run the job")
            return 0

        if status == "lost":
            ui.error("job %s was lost" % jid,
                     why="Cloud Shell VM slept or reset: remote dir exists, tmux gone, no exit_code.",
                     fix="hth run ...  # re-run the job")
            try:
                ensure_remote_base(dry_run=False, project=project)
            except Exception:
                pass
        # update local
        if info is not None:
            info["last_known_status"] = status
            if rc is not None:
                info["exit_code"] = rc
            jobs[jid] = info
            save_jobs(jobs)

        elapsed = format_elapsed(start_iso) if start_iso else "?"
        ui.blank()
        ui.info("id      %s" % ui.accent(jid))
        ui.info("state   %s" % ui.badge(status))
        ui.info("cmd     %s" % (cmd_str[:90] if cmd_str else "-"))
        if start_iso:
            ui.info("started %s" % start_iso)
            ui.info("elapsed %s" % elapsed)
        if rc is not None:
            ui.info("exit    %d" % rc)
        ui.blank()
        if status == "running":
            ui.next_step("hth logs %s -f" % jid)
        elif status in ("done", "failed"):
            ui.next_step("hth pull %s" % jid)
        else:
            ui.next_step("hth run ...  # re-run the job")
        return 0
    else:
        # list all
        try:
            with ui.step("Listing jobs"):
                remote = remote_list_all(dry_run=False, project=project)
        except SystemExit:
            raise
        except Exception as ex:
            if ui.is_debug():
                traceback.print_exc()
            fail("cannot list remote jobs", why=str(ex), fix="hth status --dry-run")

        # merge: local jobs not on remote -> missing/lost; remote jobs not local -> show anyway
        all_ids = sorted(set(list(jobs.keys())) + list(remote.keys()))
        if not all_ids:
            ui.info("no jobs yet")
            ui.next_step('hth run "echo hello"')
            return 0
        # update local statuses
        changed = False
        for jid2 in all_ids:
            if jid2 in remote:
                st, rc = remote[jid2]
                if jid2 in jobs:
                    if jobs[jid2].get("last_known_status") != st:
                        jobs[jid2]["last_known_status"] = st
                        changed = True
                    if rc is not None:
                        jobs[jid2]["exit_code"] = rc
                        changed = True
            else:
                # local only, remote missing -> mark missing (once)
                if jid2 in jobs and jobs[jid2].get("last_known_status") != "missing":
                    jobs[jid2]["last_known_status"] = "missing"
                    changed = True
        if changed:
            try:
                save_jobs(jobs)
            except Exception:
                pass

        # newest first: local start_time desc, unknown last
        def _sort_key(k):
            iso = jobs.get(k, {}).get("start_time", "") if k in jobs else ""
            return iso or ""
        all_ids.sort(key=_sort_key, reverse=True)

        rows = []
        for jid2 in all_ids:
            if jid2 in remote:
                st, rc = remote[jid2]
            else:
                st = jobs.get(jid2, {}).get("last_known_status", "missing")
                rc = jobs.get(jid2, {}).get("exit_code")
            cmd_s = jobs.get(jid2, {}).get("command", "-") or "-"
            start_iso = jobs.get(jid2, {}).get("start_time", "")
            elapsed = format_elapsed(start_iso) if start_iso else "-"
            exit_s = str(rc) if rc is not None else "-"
            rows.append((jid2, cmd_s, ui.badge(st), elapsed, exit_s))
        ui.blank()
        ui.table(["id", "command", "state", "elapsed", "exit"], rows)
        ui.blank()
        lost = [k for k, v in remote.items() if v[0] == "lost"]
        if lost:
            ui.warn("%d job(s) lost: Cloud Shell slept/reset (tmux gone, no exit_code)." % len(lost))
        ui.next_step("hth status <id>  # details, or hth logs <id> -f")
        return 0


def cmd_logs(args):
    dry_run = effective_dry_run(args)
    project = effective_project(args)
    check_gcloud_exists()
    jid = args.job_id
    if not valid_job_id(jid):
        fail("bad job id: %s" % jid,
             why="Job ids look like YYYYMMDD-HHMMSS-xxxxxx (letters, digits, -).",
             fix="hth status  # list known jobs, then copy an id")
    follow = bool(getattr(args, "follow", False))
    lines = int(getattr(args, "lines", 100) or 100)
    rdir = remote_job_dir(jid)

    if dry_run:
        ui.dry_run_cmd(build_ssh_cmd("tail -n %d %s/out.log" % (lines, rdir), project=project))
        if follow:
            ui.hint("follow: would poll every 2s via ssh")
        ui.next_step("hth logs %s  # for real (remove --dry-run)" % jid)
        return 0

    if not follow:
        r = ssh_run("tail -n %d %s/out.log 2>/dev/null || echo '[hth] no logs yet (job may still be starting)'" % (lines, rdir),
                    dry_run=False, project=project)
        ui.print_logs(r.stdout or "")
        return 0

    # follow: poll new bytes via `tail -c +N`
    offset = 0
    # First, get current size so we only follow new? No - show last `lines` first.
    r0 = ssh_run("tail -n %d %s/out.log 2>/dev/null || echo '[hth] waiting for logs...'" % (lines, rdir),
                 dry_run=False, project=project)
    ui.print_logs(r0.stdout or "")
    try:
        # estimate offset as byte length of full file
        rsize = ssh_run("wc -c < %s/out.log 2>/dev/null || echo 0" % rdir, dry_run=False, project=project)
        try:
            offset = int((rsize.stdout or "0").strip().split()[0])
        except Exception:
            offset = 0
    except Exception:
        offset = 0
    ui.err(ui.dim("following %s/out.log (Ctrl-C to stop)..." % rdir))
    try:
        while True:
            time.sleep(2)
            nxt = offset + 1
            r = ssh_run("tail -c +%d %s/out.log 2>/dev/null" % (nxt, rdir), dry_run=False, project=project)
            chunk = r.stdout or ""
            if chunk:
                ui.print_logs(chunk)
                try:
                    offset += len(chunk.encode("utf-8"))
                except Exception:
                    offset += len(chunk)
            # check if job finished; if so, drain once more and exit
            try:
                st, _rc, _raw = remote_probe_single(jid, dry_run=False, project=project)
                if st in ("done", "failed", "missing"):
                    # final drain
                    r2 = ssh_run("tail -c +%d %s/out.log 2>/dev/null" % (offset + 1, rdir),
                                 dry_run=False, project=project)
                    if r2.stdout:
                        ui.print_logs(r2.stdout)
                    ui.err("")
                    ui.err("job %s: %s" % (jid, ui.badge(st)))
                    break
            except Exception:
                pass
    except KeyboardInterrupt:
        ui.err("")
        ui.err(ui.dim("stopped following"))
    ui.next_step("hth pull %s  # when output/ is ready" % jid)
    return 0


def cmd_pull(args):
    dry_run = effective_dry_run(args)
    project = effective_project(args)
    check_gcloud_exists()
    jid = args.job_id
    if not valid_job_id(jid):
        fail("bad job id: %s" % jid,
             why="Job ids look like YYYYMMDD-HHMMSS-xxxxxx.",
             fix="hth status  # list known jobs, then copy an id")
    dest = getattr(args, "dest", None) or os.path.join("results", jid)
    rdir = remote_job_dir(jid)

    if dry_run:
        ui.hint("mkdir -p %s" % shlex.quote(dest))
        ui.dry_run_cmd(build_scp_cmd(
            ["cloudshell:%s/output" % rdir],
            "localhost:%s" % dest,
            recurse=True, project=project))
        ui.hint("dry-run: remote %s/output -> local %s/ (contents)" % (rdir, dest))
        ui.next_step("hth pull %s  # for real (remove --dry-run)" % jid)
        return 0

    # Ensure parent exists but NOT dest itself, so `scp -r remote/output dest`
    # creates dest as a copy of output (files land directly in dest/).
    parent = os.path.dirname(os.path.abspath(dest)) or "."
    os.makedirs(parent, exist_ok=True)
    dest_exists_before = os.path.exists(dest)

    # Quick check that remote output exists
    with ui.step("Checking remote output"):
        r = ssh_run("if [ -d %s/output ]; then ls -la %s/output; else echo HTH_NO_OUTPUT; fi" % (rdir, rdir),
                    dry_run=False, project=project)
    if "HTH_NO_OUTPUT" in (r.stdout or ""):
        fail("no output/ dir for job %s yet" % jid,
             why="The job has not created ./output/ on Cloud Shell (or it already failed).",
             fix="hth logs %s  # check what happened" % jid)

    with ui.step("Pulling output"):
        cmd = build_scp_cmd(["cloudshell:%s/output" % rdir], "localhost:%s" % dest,
                            recurse=True, project=project)
        run_gcloud(cmd, dry_run=False)

    # Normalize: if dest existed before, scp likely created dest/output/*. Move up.
    nested = os.path.join(dest, "output")
    if dest_exists_before and os.path.isdir(nested):
        # move nested contents up one level
        for name in os.listdir(nested):
            s = os.path.join(nested, name)
            d = os.path.join(dest, name)
            if os.path.exists(d):
                # avoid clobber: put into output/ keep? just warn
                warn("skip %s: already exists in %s" % (name, dest))
                continue
            try:
                os.rename(s, d)
            except Exception:
                pass
        try:
            if not os.listdir(nested):
                os.rmdir(nested)
        except Exception:
            pass
    ui.blank()
    ui.info("pulled  %s/output -> %s/" % (rdir, dest))
    ui.next_step("ls %s" % dest)
    return 0


def cmd_kill(args):
    dry_run = effective_dry_run(args)
    project = effective_project(args)
    check_gcloud_exists()
    jid = args.job_id
    if not valid_job_id(jid):
        fail("bad job id: %s" % jid,
             why="Job ids look like YYYYMMDD-HHMMSS-xxxxxx.",
             fix="hth status  # list known jobs, then copy an id")
    rdir = remote_job_dir(jid)
    remote_cmd = 'tmux kill-session -t %s 2>/dev/null && echo "killed %s" || echo "no tmux session %s (already done/lost)"' % (
        shlex.quote(jid), jid, jid)
    if dry_run:
        ui.dry_run_cmd(build_ssh_cmd(remote_cmd, project=project))
        ui.hint("dry-run: would mark %s as killed locally" % jid)
        return 0
    with ui.step("Killing %s" % jid):
        r = ssh_run(remote_cmd, dry_run=False, project=project)
    ui.print_logs(r.stdout or "")
    stop_keepalive(jid)
    jobs = load_jobs()
    if jid in jobs:
        jobs[jid]["last_known_status"] = "killed"
        save_jobs(jobs)
    ui.next_step("hth status %s  # confirm, or hth clean %s" % (jid, jid))
    return 0


def cmd_clean(args):
    dry_run = effective_dry_run(args)
    project = effective_project(args)
    check_gcloud_exists()
    jid = getattr(args, "job_id", None)
    yes = bool(getattr(args, "yes", False))
    if jid and not valid_job_id(jid):
        fail("bad job id: %s" % jid,
             why="Job ids look like YYYYMMDD-HHMMSS-xxxxxx.",
             fix="hth status  # list known jobs, then copy an id")

    if jid:
        remote_cmd = "rm -rf ~/hth/jobs/%s && echo cleaned %s" % (shlex.quote(jid), jid)
        if dry_run:
            ui.dry_run_cmd(build_ssh_cmd(remote_cmd, project=project))
            ui.hint("dry-run: would remove %s from %s" % (jid, LOCAL_JOBS_FILE))
            return 0
        with ui.step("Cleaning %s" % jid):
            ssh_run(remote_cmd, dry_run=False, project=project)
        stop_keepalive(jid)
        jobs = load_jobs()
        jobs.pop(jid, None)
        save_jobs(jobs)
        ui.info("cleaned %s" % jid)
        ui.next_step("hth status  # remaining jobs")
        return 0

    # clean all
    if not yes and not dry_run:
        ui.err("Remove ALL remote jobs in ~/hth/jobs and clear local state? [y/N] ")
        try:
            ans = input().strip().lower()
        except EOFError:
            ans = ""
        if ans not in ("y", "yes"):
            ui.info("aborted")
            return 0
    remote_cmd = "rm -rf ~/hth/jobs && mkdir -p ~/hth/jobs && echo cleaned-all"
    if dry_run:
        ui.dry_run_cmd(build_ssh_cmd(remote_cmd, project=project))
        ui.hint("dry-run: would clear %s" % LOCAL_JOBS_FILE)
        return 0
    with ui.step("Cleaning all jobs"):
        ssh_run(remote_cmd, dry_run=False, project=project)
    # stop all keepalives
    try:
        for p in LOCAL_DIR.glob("keepalive-*.pid"):
            try:
                pid = int(p.read_text(encoding="utf-8").strip().split()[0])
                try:
                    os.kill(pid, 15)
                except Exception:
                    pass
            except Exception:
                pass
            try:
                p.unlink()
            except Exception:
                pass
    except Exception:
        pass
    save_jobs({})
    ui.info("cleaned all jobs")
    ui.next_step('hth run "echo hello"  # start fresh')
    return 0


# ---------- argparse ----------

def _add_common_flags(parser):
    parser.add_argument("--dry-run", dest="dry_run", action="store_true",
                        help="print gcloud commands instead of running them")
    parser.add_argument("--project", dest="project", default=None, metavar="P",
                        help="GCP project override (or HTH_PROJECT)")
    parser.add_argument("--no-color", dest="no_color", action="store_true",
                        help="plain output, no ANSI colors or spinners")
    parser.add_argument("--debug", dest="debug", action="store_true",
                        help="show raw tracebacks on failure")


def build_parser():
    p = argparse.ArgumentParser(
        prog="hth",
        description="Hand long-running tasks off to Google Cloud Shell.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="Setup:\n"
               "  hth init                                   # first-time auth + ~/hth/jobs\n"
               "Run:\n"
               "  hth run \"python3 job.py\"                   # detached in tmux\n"
               "  hth run ./scrape.py --files data/          # with uploads\n"
               "Inspect:\n"
               "  hth status                                 # all jobs, newest first\n"
               "  hth logs <id> -f                           # follow output\n"
               "  hth pull <id>                              # fetch ./output/\n"
               "Cleanup:\n"
               "  hth kill <id>                              # stop tmux session\n"
               "  hth clean <id>                             # remove one job\n",
    )
    p.add_argument("--dry-run", dest="global_dry_run", action="store_true",
                   help="print gcloud commands instead of running them")
    p.add_argument("--project", dest="global_project", default=None,
                   help="GCP project (or set HTH_PROJECT). Passed as --project to gcloud.")
    p.add_argument("--no-color", dest="global_no_color", action="store_true",
                   help="plain output, no ANSI colors or spinners")
    p.add_argument("--debug", dest="global_debug", action="store_true",
                   help="show raw tracebacks on failure")
    p.add_argument("--version", action="version", version="hth " + VERSION)
    sub = p.add_subparsers(dest="cmd", required=True, metavar="<command>")

    _fmt = argparse.RawDescriptionHelpFormatter
    q = sub.add_parser("init", help="check gcloud, start Cloud Shell, create ~/hth/jobs",
                       description="Authorize Cloud Shell and create ~/hth/jobs.",
                       epilog="Example:\n  hth init",
                       formatter_class=_fmt)
    _add_common_flags(q)

    r = sub.add_parser("run", help="run a command or script file detached on Cloud Shell",
                       description="Copy a script + files to ~/hth/jobs/<id>/ and launch it detached in tmux.",
                       epilog="Example:\n  hth run \"python3 -u job.py --out ./output\"\n  hth run ./scrape.py --files data/ --keepalive",
                       formatter_class=_fmt)
    r.add_argument("target", help="shell command string OR path to .py/.sh file")
    r.add_argument("extra", nargs="*", help="extra args (appended to command, or passed to script)")
    r.add_argument("--files", nargs="*", default=[], metavar="F",
                   help="extra local files/dirs to upload into the job dir")
    r.add_argument("--setup", dest="setup", default=None, metavar="FILE",
                   help="local setup script uploaded as setup.sh (runs first)")
    r.add_argument("--keepalive", action="store_true",
                   help="spawn background ssh ping to keep Cloud Shell awake")
    _add_common_flags(r)

    s = sub.add_parser("status", help="list jobs or show one job",
                       description="List jobs (newest first) or show one job with state and elapsed time.",
                       epilog="Example:\n  hth status\n  hth status 20261116-120000-ab12cd",
                       formatter_class=_fmt)
    s.add_argument("job_id", nargs="?", default=None, help="job id (omit to list all)")
    _add_common_flags(s)

    lg = sub.add_parser("logs", help="show job logs",
                        description="Tail ~/hth/jobs/<id>/out.log over ssh. -f polls for new bytes.",
                        epilog="Example:\n  hth logs 20261116-120000-ab12cd -f",
                        formatter_class=_fmt)
    lg.add_argument("job_id", help="job id")
    lg.add_argument("-f", "--follow", action="store_true", help="follow (polls over ssh)")
    lg.add_argument("-n", "--lines", type=int, default=100, help="lines to show (default 100)")
    _add_common_flags(lg)

    pl = sub.add_parser("pull", help="copy remote output/ back to ./results/<id>/",
                        description="Copy ~/hth/jobs/<id>/output/ to ./results/<id>/ via scp.",
                        epilog="Example:\n  hth pull 20261116-120000-ab12cd",
                        formatter_class=_fmt)
    pl.add_argument("job_id", help="job id")
    pl.add_argument("--dest", dest="dest", default=None, help="local dir (default results/<id>)")
    _add_common_flags(pl)

    k = sub.add_parser("kill", help="kill a running job (tmux session)",
                       description="Kill the tmux session for a job. Logs and output stay on Cloud Shell.",
                       epilog="Example:\n  hth kill 20261116-120000-ab12cd",
                       formatter_class=_fmt)
    k.add_argument("job_id", help="job id")
    _add_common_flags(k)

    c = sub.add_parser("clean", help="remove remote job dirs",
                       description="Remove one remote job dir, or all jobs with confirmation.",
                       epilog="Example:\n  hth clean 20261116-120000-ab12cd\n  hth clean -y",
                       formatter_class=_fmt)
    c.add_argument("job_id", nargs="?", default=None, help="job id (omit for all)")
    c.add_argument("-y", "--yes", action="store_true", help="skip confirmation for clean-all")
    _add_common_flags(c)

    hk = sub.add_parser("_keepalive", help=argparse.SUPPRESS)
    hk.add_argument("job_id", nargs="?", default=None)
    hk.add_argument("--project", dest="project", default=None)
    hk.add_argument("--no-color", dest="no_color", action="store_true", help=argparse.SUPPRESS)
    hk.add_argument("--debug", dest="debug", action="store_true", help=argparse.SUPPRESS)
    hk.add_argument("--dry-run", dest="dry_run", action="store_true", help=argparse.SUPPRESS)
    return p


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    # defaults for flags when subparser didn't define them
    for _name, _default in (("dry_run", False), ("no_color", False), ("debug", False),
                            ("project", None), ("global_no_color", False),
                            ("global_debug", False), ("global_dry_run", False),
                            ("global_project", None)):
        if not hasattr(args, _name):
            setattr(args, _name, _default)
    try:
        ui.configure(no_color=effective_no_color(args), debug=effective_debug(args))
    except Exception:
        pass
    cmd = args.cmd
    try:
        if cmd == "init":
            return cmd_init(args)
        if cmd == "run":
            return cmd_run(args)
        if cmd == "status":
            return cmd_status(args)
        if cmd == "logs":
            return cmd_logs(args)
        if cmd == "pull":
            return cmd_pull(args)
        if cmd == "kill":
            return cmd_kill(args)
        if cmd == "clean":
            return cmd_clean(args)
        if cmd == "_keepalive":
            # normalize: _keepalive takes job_id positionally as `job_id`
            class A:
                pass
            a = A()
            a.job_id = getattr(args, "job_id", None)
            a.target = a.job_id
            a.project = getattr(args, "project", None)
            a.global_project = getattr(args, "global_project", None)
            return cmd_keepalive_loop(a)
        parser.print_help()
        return 2
    except KeyboardInterrupt:
        ui.err("")
        ui.err(ui.dim("cancelled"))
        return 130
    except SystemExit:
        raise
    except Exception as ex:
        if ui.is_debug():
            traceback.print_exc()
            return 1
        ui.error("unexpected failure: %s" % ex,
                 why="This is a bug, not your command. Nothing was sent twice.",
                 fix="hth --debug %s  # re-run with a traceback" % " ".join(sys.argv[1:3]))
        return 1


if __name__ == "__main__":
    sys.exit(main())
